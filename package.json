{
  "name": "college-complaint-management-system",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,cyan \"npm run dev --workspace backend\" \"npm run dev --workspace frontend\"",
    "build": "node scripts/build.js",
    "start": "npm run start --workspace backend",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:setup": "npm run db:setup --workspace backend",
    "db:seed": "npm run db:seed --workspace backend",
    "test": "npm run test --workspace backend",
    "tunnel": "npx localtunnel --port 4000"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}